// Multiplies every element in place. Two of these back to back is a
// write-after-write hazard between passes, which is what the barriers in
// main.py are about.
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Data { float values[]; };
layout(push_constant) uniform Push { float factor; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < values.length()) {
        values[i] = values[i] * pc.factor;
    }
}
