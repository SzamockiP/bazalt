// Adds the producer's numbers into the running total. It READS what
// produce.comp wrote, which is the dependency the two queues have to carry
// between them: after N replays dst[i] holds 1 + 2 + ... + N, and any missing
// edge gives a smaller number.
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Source { uint src[]; };
layout(set = 0, binding = 1) buffer Destination { uint dst[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < src.length()) {
        dst[i] = dst[i] + src[i];
    }
}
