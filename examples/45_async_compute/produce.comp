// Adds one to every element. The producer half of the chain in main.py, and
// the pass that moves to the compute queue.
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Source { uint src[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < src.length()) {
        src[i] = src[i] + 1u;
    }
}
