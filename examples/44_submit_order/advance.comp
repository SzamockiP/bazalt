// One step of a chain: read the previous slot, write the next one. Running
// step N before step N-1 has finished gives the wrong answer, which is what
// makes the ordering in main.py visible in the numbers.
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Data { uint values[]; };
layout(push_constant) uniform Push { uint step; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < values.length()) {
        values[i] = values[i] * 2u + pc.step;
    }
}
