#version 450
// Adds up a buffer the shader never got a descriptor for.
#extension GL_EXT_buffer_reference : require
// For the uint64_t below. Needs Feature.SHADER_INT64 on the Context.
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// The size comes from the pipeline (.constant(0, group)), not from this line.
// The literal is only what a device without maintenance4 falls back to.
layout(local_size_x_id = 0, local_size_x = 64) in;

layout(buffer_reference, std430) readonly buffer Words { uint v[]; };
layout(buffer_reference, std430) buffer Sums { uint v[]; };

layout(push_constant, std430) uniform PC {
    Words words;
    Sums sums;
    uint64_t count;
};

void main()
{
    // One partial sum per thread, strided so neighbouring threads read
    // neighbouring words. uint indexing reaches 4G elements, which is 16 GiB of
    // a uint buffer — past anything a descriptor could have bound.
    uint stride = gl_WorkGroupSize.x;
    uint total = 0u;
    for (uint i = gl_LocalInvocationID.x; i < uint(count); i += stride)
    {
        total += words.v[i];
    }
    sums.v[gl_LocalInvocationID.x] = total;
}
