#version 450
// The plain case: a direct OpStore through an access chain into an SSBO.
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) buffer Out { uint v[]; };
layout(std430, set = 0, binding = 1) readonly buffer In { uint src[]; };
void main() { v[gl_GlobalInvocationID.x] = src[gl_GlobalInvocationID.x] + 1u; }
