#version 450

// The workgroup size stays literal: specializing it (local_size_x_id) emits
// OpExecutionMode LocalSizeId, which needs Vulkan 1.3 / maintenance4, and the
// baseline here is 1.2.
layout(local_size_x = 8) in;
layout(constant_id = 1) const int ADDEND = 1;

layout(std430, binding = 0) buffer Data {
    int values[];
};

void main() {
    values[gl_GlobalInvocationID.x] += ADDEND;
}
