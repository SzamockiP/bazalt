#version 450

// Writes a coordinate-derived color into every texel of an 8x8x8 volume, so a
// test can predict the value at any (x, y, z) exactly.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(binding = 0, rgba8) uniform image3D vol;

void main() {
    ivec3 p = ivec3(gl_GlobalInvocationID);
    imageStore(vol, p, vec4(float(p.x) / 7.0, float(p.y) / 7.0, float(p.z) / 7.0, 1.0));
}
